PORT=5000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/email_scheduler?schema=public"
REDIS_URL="redis://localhost:6379"
FRONTEND_URL="http://localhost:5173"
FRONTEND_URLS="http://localhost:5173,http://localhost:5174"
WORKER_CONCURRENCY=5
RATE_LIMIT_WINDOW_MS=3600000

# Clerk Authentication
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Email Provider Configuration (Default: 'ethereal' for assignment compliance)
EMAIL_PROVIDER=ethereal

# Ethereal SMTP Configuration (Default & Required for Assignment Testing)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ReachInbox Scheduler <noreply@reachinbox.ai>"

# Optional HTTP Email Provider (Used only if EMAIL_PROVIDER=resend)
RESEND_API_KEY=
