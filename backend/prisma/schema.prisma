generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EmailStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

model Campaign {
  id           String      @id @default(uuid())
  subject      String
  body         String
  sender       String
  startTime    DateTime
  delaySeconds Int
  hourlyLimit  Int
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  emails       Email[]
}

model Email {
  id             String      @id @default(uuid())
  campaignId     String
  campaign       Campaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  recipientEmail String
  scheduledAt    DateTime
  status         EmailStatus @default(PENDING)
  sentAt         DateTime?
  attempts       Int         @default(0)
  errorMessage   String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([campaignId])
  @@index([status])
  @@index([scheduledAt])
}
